# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node / SvelteKit build output
node_modules/
web/build/
.svelte-kit/

# Large or generated binaries
*.parquet
*.npy
*.pkl
*.part

# Logs and local config
*.log
.env
.env.*
!.env.example

